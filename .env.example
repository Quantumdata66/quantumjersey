# ============================================================
# Quantum Jersey — Environment Configuration Template
# ============================================================
# Copy this file to .env.local for local testing.
# Never commit real secrets, service-role keys, or private API keys to git.

# ─── Supabase Configuration ───────────────────────────────────
# SUPABASE_URL: Project URL (e.g. https://your-project.supabase.co)
# Required on: Client Storefront, Admin Panel, and Vercel Serverless Functions
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Public client-side anonymous key (RLS-enforced)
# Required on: Client Storefront and Admin Panel
SUPABASE_ANON_KEY=your-anon-key-here

# SUPABASE_SERVICE_ROLE_KEY: Private server-only administration key (bypasses RLS)
# CRITICAL: Keep strictly server-side. NEVER expose to the browser or public client!
# Required on: Vercel Serverless Backend (Environment Variables Settings)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Paystack Payment Gateway Configuration ───────────────────
# PAYSTACK_PUBLIC_KEY: Public key for future frontend checkout integration
# Required on: Client Storefront (future integration)
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# PAYSTACK_SECRET_KEY: Secret key for serverless initialization, verification, and webhooks
# CRITICAL: Keep strictly server-side. NEVER expose to the browser or public client!
# Required on: Vercel Serverless Backend (Environment Variables Settings)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# ─── Storefront Application Origin Configuration ──────────────
# APP_BASE_URL: Base URL of the storefront application (e.g. https://quantumjersey.vercel.app)
# Required on: Vercel Serverless Backend for trusted Paystack return callback construction
# Production MUST be HTTPS. Local development is restricted to http://localhost:* or http://127.0.0.1:*
APP_BASE_URL=https://quantumjersey.vercel.app

